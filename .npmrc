# better-sqlite3 ships working prebuilt native binaries for every common
# platform (node_modules/better-sqlite3/prebuilds/), but the package has no
# install/postinstall script of its own — so npm falls back to its legacy
# "binding.gyp present, no install script => auto node-gyp rebuild"
# behavior, which tries to download Node headers from nodejs.org even
# though nothing actually needs compiling. That's an unnecessary network
# dependency at best, and a hard failure in sandboxed/offline/restricted
# environments (including this project's own Docker build, whose base
# image has neither build tools nor that network access) at worst.
#
# Nothing in this project's own dependency tree needs its install scripts
# to run (verified: esbuild's native binary comes via optionalDependencies,
# which install regardless of this setting; Playwright's browser download
# is an explicit separate step either way — see README "Quick start").
ignore-scripts=true
