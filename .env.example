# NULLLAB environment configuration — copy to .env and adjust if needed.
# All defaults below are safe for local-only use. Never put real secrets here.

# ---- Control plane API ----
API_PORT=4000
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173

# Session cookie signing secret — any local random string is fine.
# Generate your own with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef

# ---- Control plane database ----
DATABASE_PATH=./data/control.db

# ---- Lab runtime mode ----
# "process"  = dev/test mode: lab targets run as isolated local Node processes
#              (own port, own in-memory/per-instance SQLite DB). Fully works
#              without Docker — recommended for trying NULLLAB quickly.
# "docker"   = production-style isolation: each lab instance runs in its own
#              Docker container with no outbound network access. Requires
#              Docker Desktop / Docker Engine + Docker Compose v2.
RUNTIME_MODE=process

# Port range the orchestrator allocates to lab target instances (process mode)
LAB_PORT_RANGE_START=5100
LAB_PORT_RANGE_END=5999

# Minutes of inactivity before a running lab instance is auto-stopped
LAB_INSTANCE_IDLE_MINUTES=30
# Hard maximum lifetime of a lab instance regardless of activity
LAB_INSTANCE_MAX_MINUTES=120

# ---- Docker mode only ----
LAB_DOCKER_NETWORK=nulllab_labnet
LAB_DOCKER_IMAGE_PREFIX=nulllab-lab

# ---- XSS admin-bot (headless browser) ----
# Needed to verify XSS labs: a headless Chromium "visits" lab pages as a
# simulated admin so script execution can be proven, not just reflected
# text. `npm install` + Playwright's own postinstall normally download a
# matching browser automatically and you can leave these blank. Only set
# NULLLAB_CHROMIUM_EXECUTABLE if you see a "browser not found" error and
# want to point at a Chromium/Chrome binary you already have installed.
# NULLLAB_CHROMIUM_EXECUTABLE=
# Only needed in certain containers/CI where Chromium's sandbox can't
# start (set to true if you see sandbox-related launch errors).
# NULLLAB_CHROMIUM_NO_SANDBOX=false

# --- Networking (see docs/architecture.md) -----------------------------------
# Interface lab targets listen on. Keep 127.0.0.1 for a normal host install.
# docker-compose.yml overrides this to 0.0.0.0 INSIDE the container only and
# publishes the lab port range to the host's loopback.
LAB_BIND_HOST=127.0.0.1
# Experimental docker runtime only (see docs/docker-mode.md):
# LAB_DOCKER_IMAGE_TAG=local
# NULLLAB_SELF_CONTAINER=nulllab
